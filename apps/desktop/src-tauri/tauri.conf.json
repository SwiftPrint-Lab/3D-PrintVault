{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D-PrintVault",
  "version": "0.1.1",
  "identifier": "com.swiftprintlab.printvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3D-PrintVault",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://3d-printvault-production.up.railway.app; img-src 'self' asset: http://asset.localhost data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQzRDQUY4MTg4NEE1NTEKUldSUnBZUVkrTXJFY01Ya0R3d01KcVpIcHU3RlVEaHQ1UzgzNmU5RllJalZSWUtSRXBmbGlRQkUK",
      "endpoints": [
        "https://github.com/SwiftPrint-Lab/3D-PrintVault/releases/latest/download/latest.json"
      ]
    }
  }
}
