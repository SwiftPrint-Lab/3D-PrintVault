{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:default",
    "process:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        {
          "path": "$HOME/**/*"
        }
      ]
    },
    "fs:allow-unwatch"
  ]
}